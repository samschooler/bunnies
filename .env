# Server
PORT=7654
NODE_ENV=development

# Dev mode: three separate processes, each on its own Caddy subdomain.
#   display    (vite :5173) -> https://bunnies.dark.computer
#   controller (vite :5174) -> https://bunnies-ctrl.dark.computer
#   server     (node :7654) -> https://bunnies-srv.dark.computer
VITE_GAME_SERVER_URL=https://bunnies-srv.dark.computer
VITE_GAME_DISPLAY_URL=https://bunnies.dark.computer
VITE_GAME_CONTROLLER_URL=https://bunnies-ctrl.dark.computer

# Production single-domain config (NODE_ENV=production, npm start):
# VITE_GAME_SERVER_URL=https://bunnies.dark.computer
# VITE_GAME_DISPLAY_URL=https://bunnies.dark.computer
# VITE_GAME_CONTROLLER_URL=https://bunnies.dark.computer
