# Server Configuration
PORT=3000
NODE_ENV=development

# Application URLs - Full URLs including protocol, hostname, and port
# For local development:
VITE_GAME_SERVER_URL=http://localhost:3000
VITE_GAME_DISPLAY_URL=http://localhost:5173
VITE_GAME_CONTROLLER_URL=http://localhost:5174

# For production (example):
